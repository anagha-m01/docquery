# Copy this file to .env and fill in real values. Never commit .env itself.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=groq/compound-mini

# Postgres (defaults match docker-compose.yml — only change if you're
# running Postgres outside Docker)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=docquery_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

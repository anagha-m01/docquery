# Copy this file to .env and fill in real values. Never commit .env itself.

# Groq API key — https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Postgres (defaults match docker-compose.yml — only change if you're
# running Postgres outside Docker)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=docquery_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Auth — JWT signing secret. MUST be changed to a long random value in
# any real deployment; the default is only safe for local dev.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Uploads
MAX_UPLOAD_BYTES=26214400